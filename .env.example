# Supported deployed combination: demo + mock only.
APP_MODE=demo
HUBSPOT_MODE=mock

# Required for demo sessions (server-only). Do not commit real values.
# Generate a local secret:
#   openssl rand -hex 32
# Minimum length: 32 characters. Required on Vercel Preview/Production.
DEMO_SESSION_SECRET=

# Optional — paste when you have the HubSpot app. Enables inbound v3 webhook signatures.
# Does not enable HUBSPOT_MODE=live (no outbound CRM writes).
# HUBSPOT_CLIENT_SECRET=

# Optional — Jake's public HubSpot Meetings link (shown on the lead page).
# JAKE_MEETINGS_URL=

# Optional — server-only overnight persist for ingest + manual logs.
# Marketplace already sets these on Vercel. Tests omit them (memory only).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
